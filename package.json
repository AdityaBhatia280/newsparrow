{
  "name": "sparrow",
  "version": "1.0.0",
  "private": true,
  "description": "Sparrow: extracurriculars, colleges and applications for high school students",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --use-system-ca --env-file-if-exists=.env server/local.mjs",
    "dev": "npm run build && npm start",
    "test": "node tests/smoke.mjs",
    "test:integration": "node --test \"tests/unit/*.test.mjs\" \"tests/integration/*.test.mjs\"",
    "db:migrate": "node --use-system-ca --env-file-if-exists=.env scripts/db.mjs migrate",
    "db:seed": "node --use-system-ca --env-file-if-exists=.env scripts/db.mjs seed",
    "colleges:fetch": "node scripts/fetch-colleges.mjs",
    "catalog:check": "node scripts/check-links.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "postgres": "4.1.1",
    "preact": "11.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/anton": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "lucide-preact": "1.79.0",
    "pdfjs-dist": "6.5.438"
  }
}
