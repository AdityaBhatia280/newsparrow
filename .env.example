# Copy to .env for local development. Set the same values as Vercel environment variables (server-side only).
# Never commit real values.

# Google sign-in: an OAuth "Web application" client (redirect URI: <origin>/api/auth)
SPARROW_GOOGLE_CLIENT_ID=
SPARROW_GOOGLE_CLIENT_SECRET=

# Postgres (Neon): the pooled connection string
DATABASE_URL=

# The public origin of this deployment (local: http://127.0.0.1:4173)
SPARROW_AUTH_ORIGIN=https://newsparrow.vercel.app

# 40+ random characters. Encrypts sign-in cookies. Rotating it signs everyone out.
SPARROW_SESSION_SECRET=
# 32+ random characters. Encrypts publik keys at rest. Never rotate without re-encrypting.
SPARROW_DATA_KEY=

# publik (Sign in with publik + AI)
PUBLIK_APP_TOKEN=
# 32+ random characters. Derives each person's install ID. Keep it the same across deploys.
PUBLIK_INSTALL_SECRET=

# Reviewer accounts (comma-separated emails) and the public contact address for Privacy/Terms/Support
SPARROW_ADMIN_EMAILS=
SPARROW_SUPPORT_EMAIL=

# Optional: free api.data.gov key for refreshing college data with npm run colleges:fetch
DATA_GOV_API_KEY=
